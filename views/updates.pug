doctype html
html
    head
        title Update Custom Object Form | Integrating With HubSpot I Practicum
        link(rel="stylesheet", href="/css/homepage.css")
    body
        ul.navbar
            li
                a(href='/') Homepage
            li
                a(href='/update-cobj') Add to this table


        h1 Create new cocktail object
        form(action="/update-cobj" method="POST")
            div
                label(for="name") Name:
                input(type="text" name="name" id="name" required)

            div
                label(for="strength") strength:
                input(type="text" name="strength" id="strength" required)

            div
                label(for="difficulty") difficulty:
                input(type="text" name="difficulty" id="difficulty" required)
            div
                button(type="submit") Submit