doctype html
html
    head
        title Homepage
    body
        ul
            li
                a(href='/') Homepage
            li
                a(href='/update-cobj') Add to this table

        h1 Homepage
        table
            thead
                tr
                    th Name
                    th Strength
                    th Difficulty
            tbody
                each cocktail in cocktailInfo
                    tr
                        td #{cocktail.properties.name}
                        td #{cocktail.properties.strength}
                        td #{cocktail.properties.difficulty}
